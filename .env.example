PARRY_API_KEY=

# Optional: pull Square payments to check who paid (see README). Leave blank to turn it off.
SQUARE_API_KEY=
# Required with SQUARE_API_KEY: sandbox or production, matching the token (production for real payments)
SQUARE_ENV=sandbox
# Optional: pull the last 14 days of tracked series automatically every N hours (blank = off)
SQUARE_AUTO_PULL_HOURS=
# Local time zone of your tournaments, e.g. Australia/Hobart (used for the Square time window)
TZ=UTC
