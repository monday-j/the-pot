# Required: the shared login password (the app refuses every page without one)
POT_PASSWORD=
# Optional: host names/addresses the app answers to, comma-separated (blocks DNS rebinding), e.g.
# 192.168.1.10,pot.lan,localhost,127.0.0.1 (keep 127.0.0.1 for the healthcheck). Blank = any.
POT_ALLOWED_HOSTS=
# Optional: 1 if served over HTTPS (marks the login cookie Secure)
POT_COOKIE_SECURE=

PARRY_API_KEY=

# Optional: read-only Square access to check who paid (see README, "Square: read-only access"). Leave blank to turn it off.
# sandbox or production, matching the credentials below (production for real payments)
SQUARE_ENV=sandbox
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
# Printed once by `python -m app.square_oauth exchange ...`
SQUARE_REFRESH_TOKEN=
# Optional: pull the last 14 days of tracked series automatically every N hours (blank = off)
SQUARE_AUTO_PULL_HOURS=
# Local time zone of your tournaments, e.g. Australia/Hobart (used for the Square time window)
TZ=UTC

# Optional: a weekly email reminding you to process payments (blank SMTP_HOST or REMINDER_TO = off).
# Port 587 uses STARTTLS, 465 TLS from the start. Try it with `python -m app.mail test`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address (default: SMTP_USER)
SMTP_FROM=
# Who gets it, comma-separated
REMINDER_TO=
# When, in TZ: day mon..sun (default mon) and hour 0-23 (default 9)
REMINDER_DAY=mon
REMINDER_HOUR=9
# Optional: the app's address, for links in the email, e.g. http://pot.lan:8000
POT_URL=
